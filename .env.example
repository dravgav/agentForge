# Copy this file to .env and replace the placeholder key. Never commit .env.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Optional: the request the agents should implement.
# Use a single line to avoid .env parsing surprises.
ENGINEERING_REQUIREMENTS="Build a single-user task tracker with add, list, complete, and delete actions."

# Optional: CrewAI may prompt for tracing; see the CrewAI documentation.
# CREWAI_TRACING_ENABLED=false
